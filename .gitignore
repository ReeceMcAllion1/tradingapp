# Local configuration - may contain venue-specific settings
config.toml

# configs/ holds committed session templates; local edits are yours
configs/local_*.toml

# Runtime state: positions, equity, logs
state/
*.log

# Market data
data/*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Never commit credentials
.env
*.key
*.secret

# Guard against two mutation sweeps editing source at once
.mutation-sweep.lock/
